# ==============================================================================
# FinSight Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env          (Linux/macOS)
#      Copy-Item .env.example .env   (Windows PowerShell)
# 2. Fill in the real credentials below.
# 3. NEVER commit your actual '.env' file to Git.
# ==============================================================================

# SEC EDGAR API Configuration
# SEC fair-access policy requires a User-Agent in the format: "Sample Company Name AdminContact@<sample company domain>.com"
SEC_EDGAR_USER_AGENT="FinSight Research Team (contact: your_email@example.com)"

# Qdrant Vector Database (Cloud Cluster)
# Get these credentials from your team lead (Nilay) or your Qdrant Cloud dashboard (https://cloud.qdrant.io)
QDRANT_URL="https://your-cluster-id.us-east-2-0.aws.cloud.qdrant.io"
QDRANT_API_KEY="your_qdrant_api_key_here"
