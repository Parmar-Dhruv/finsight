# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl

# ===========================
# Virtual Environments
# ===========================
venv/
.venv/
env/
.env/
ENV/

